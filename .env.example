# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional AI Provider Keys (falls back to built-in deterministic AI engine if omitted)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Site URL for OAuth redirects and shareable resume links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# YouPI-PG Self-Hosted UPI Payment Gateway (server-side only keys)
YOUPI_API_URL=http://localhost:6100
YOUPI_CHECKOUT_URL=http://localhost:7000
YOUPI_MERCHANT_ID=00000000-0000-0000-0000-000000000001
YOUPI_MERCHANT_API_KEY=
YOUPI_WEBHOOK_SECRET=
YOUPI_PAYEE_VPA=merchant@upi

# Firebase Client SDK (Hosting, Auth, Firestore, Storage)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-side Firestore payments/subscriptions/invoices)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Fallback Payment Option (Razorpay / Manual UPI)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_MANUAL_UPI_VPA=resumepro@upi
NEXT_PUBLIC_MANUAL_UPI_NAME=ResumePro AI

# Payment Confirmation Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=billing@resumepro.ai
