rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User-owned resume PDFs and invoices
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /invoices/{userId}/{invoiceFile} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
      allow write: if false; // Written exclusively by Firebase Admin SDK
    }
  }
}
